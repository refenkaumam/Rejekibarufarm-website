# Salin menjadi backend/.env (file .env TIDAK boleh di-commit).
# Backend membaca file ini otomatis; environment variable yang sudah diset tetap diutamakan.

# development | production
APP_ENV=development
# Produksi di belakang reverse proxy: HOST=127.0.0.1 (kosong = semua interface)
HOST=
PORT=8080

# Koneksi MySQL. Laragon bawaan: root tanpa password.
# Produksi: pakai user khusus aplikasi, jangan root.
DB_DSN=root@tcp(127.0.0.1:3306)/rejeki

# Wajib di produksi, minimal 32 karakter acak. Contoh membuat:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux:      openssl rand -base64 48
JWT_SECRET=

# Origin frontend yang boleh memanggil API (pisah koma, tanpa garis miring di akhir).
# Wajib di produksi, termasuk bila frontend & API satu domain. Contoh: https://farm.contoh.com
ALLOWED_ORIGINS=http://localhost:5173

# IP reverse proxy yang dipercaya untuk header X-Forwarded-For (kosongkan bila tanpa proxy)
TRUSTED_PROXIES=

# Cookie sesi. Produksi (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# lax | strict | none (none hanya bila frontend & API beda domain, wajib COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Lama sesi login (15m - 168h)
SESSION_TTL=12h

# Password akun 'admin' pertama (hanya dipakai bila tabel users masih kosong, minimal 10 karakter).
# Kosongkan untuk dibuatkan password acak yang ditampilkan sekali di log server.
ADMIN_INITIAL_PASSWORD=
