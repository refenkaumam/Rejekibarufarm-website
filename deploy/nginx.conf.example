# Contoh konfigurasi Nginx produksi: frontend (hasil `npm run build`) dan API Go satu domain.
# Ganti farm.contoh.com dan path sesuai server. JANGAN menjalankan `vite` / `vite preview` di produksi.

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

server {
    listen 80;
    server_name farm.contoh.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name farm.contoh.com;

    ssl_certificate     /etc/letsencrypt/live/farm.contoh.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farm.contoh.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 1m;

    # Header keamanan untuk halaman frontend
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    # Frontend statis (folder frontend/dist hasil build)
    root /var/www/rejeki/frontend/dist;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # API Go (backend hanya listen di localhost)
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Pasangan env backend untuk konfigurasi di atas:
#   APP_ENV=production
#   HOST=127.0.0.1
#   ALLOWED_ORIGINS=https://farm.contoh.com
#   TRUSTED_PROXIES=127.0.0.1
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=lax
# dan frontend dibuild dengan VITE_API_URL=/api
