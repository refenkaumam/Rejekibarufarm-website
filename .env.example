# Salin menjadi .env di folder root (di server: folder project) lalu isi nilainya.
# File .env TIDAK boleh di-commit. Buat nilai acak dengan: openssl rand -hex 24
# Password database sebaiknya huruf & angka saja (karakter @ : / merusak DB_DSN).

# ===== Produksi (docker-compose.prod.yml) =====
# Alamat publik aplikasi, sama persis dengan di browser (https, tanpa / di akhir)
APP_ORIGIN=https://farm.domainmu.com
# Minimal 32 karakter acak: openssl rand -hex 32
JWT_SECRET=

# Database di container MariaDB yang sudah ada (buat database & user-nya lewat phpMyAdmin)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=rejeki
DB_USER=rejeki_app
DB_PASSWORD=
# Nama network Docker tempat container MariaDB berada
DB_NETWORK=db-net

# Password akun 'admin' pertama (dipakai hanya bila tabel users masih kosong, minimal 10 karakter).
# Kosongkan bila data diimpor dari database lama.
ADMIN_INITIAL_PASSWORD=
# Lama sesi login (opsional)
SESSION_TTL=12h

# ===== Lokal dengan Docker (docker-compose.yml, MySQL sendiri) =====
MYSQL_ROOT_PASSWORD=
MYSQL_USER=rejeki_app
MYSQL_PASSWORD=
